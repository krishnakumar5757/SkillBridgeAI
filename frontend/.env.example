# =============================================================================
# SkillBridge AI — Frontend Environment Configuration
# =============================================================================
# Copy this file to .env.local and adjust as needed.
# Vite only exposes environment variables prefixed with VITE_.
# =============================================================================

# API URL — leave empty to use relative paths (Vite dev-server proxy).
# Set to http://localhost:8000 if running the frontend separately.
VITE_API_URL=

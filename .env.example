# =============================================================================
# SkillBridge AI — Environment Configuration Template
# =============================================================================
# Copy this file to .env and fill in the values.
# NEVER commit the real .env file to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
# SQLite connection string for development. Single-file database.
# To switch to PostgreSQL, change to: postgresql+psycopg2://user:pass@localhost/skillbridge
DATABASE_URL=sqlite:///./skillbridge.db

# -----------------------------------------------------------------------------
# Authentication
# -----------------------------------------------------------------------------
# JWT secret key — generate a strong random value for production.
# Example: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=change-me-to-a-strong-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRY_HOURS=24

# -----------------------------------------------------------------------------
# File Storage (Resume Uploads)
# -----------------------------------------------------------------------------
UPLOAD_DIR=./uploads

# -----------------------------------------------------------------------------
# NLP Configuration
# -----------------------------------------------------------------------------
# spaCy model: en_core_web_sm (default, ~15MB) or en_core_web_md (better NER, ~40MB)
SPACY_MODEL=en_core_web_sm

# -----------------------------------------------------------------------------
# CORS Configuration
# -----------------------------------------------------------------------------
# Comma-separated list of allowed frontend origins.
# Vite dev server runs on http://localhost:5173 by default.
CORS_ORIGINS=http://localhost:5173

# -----------------------------------------------------------------------------
# Optional: LLM Integration (NOT required for core functionality)
# -----------------------------------------------------------------------------
# The core system works fully without any LLM. If enabled, the LLM is used
# only for supplementary text generation (descriptions, explanations).
# It NEVER replaces A* or Forward Chaining.
ENABLE_LLM=false
# OPENAI_API_KEY=your-api-key-here

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
# Debug mode: enables verbose logging, SQL echo, and FastAPI docs.
# Set to true for local development; set to false for any shared/demo run.
# When false, the app refuses to start with an insecure JWT_SECRET.
DEBUG=true
